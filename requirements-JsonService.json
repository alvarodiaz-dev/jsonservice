{
  "services": [
    {
      "serviceName": "JsonService",
      "description": "Microservice that retrieves sample JSON data from the JSONPlaceholder API for testing and demonstration purposes.",
      "endpoints": [
        {
          "method": "GET",
          "path": "/posts",
          "description": "Returns all posts from JSONPlaceholder API"
        },
        {
          "method": "GET",
          "path": "/posts/{id}",
          "description": "Returns a specific post by ID from JSONPlaceholder API"
        }
      ],
      "dataModels": [
        {
          "name": "Post",
          "fields": [
            "id: integer",
            "userId: integer",
            "title: string",
            "body: string"
          ]
        }
      ],
      "externalDependencies": [
        "JSONPlaceholder API (https://jsonplaceholder.typicode.com)"
      ]
    }
  ]
}